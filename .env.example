# Day-to-day deploy uses data/config/gateway.toml.
# These env vars are optional overrides only — not required.
# CURSOR_API_KEY=
# CURSOR_API_KEYS=key-2,key-3
# CURSOR_KEY_COOLDOWN_MS=60000
# CURSOR_KEY_STRATEGY=round_robin
# ANTHROPIC_COUNT_TOKENS=off
# MODEL_ALIASES=claude-*=composer-2.5
# ALLOW_MAX_MODE=true
# QUOTA_CACHE_READ_WEIGHT=1
# QUOTA_RESERVE_RECENT_RUNS=20
# ENFORCE_OUTPUT_LIMITS=false
# HISTORY_RESUME=false
# TRUSTED_PROXIES=
# ADMIN_ACCESS_KEY=
# API_KEY_PEPPER=
# GATEWAY_HOST wins over gateway.toml `host` (a warning is logged if they differ).
# GATEWAY_HOST=127.0.0.1
# GATEWAY_PORT=8787
# DATA_DIR=data
# CURSOR_WORKSPACE=
# LOG_RETENTION_DAYS=
# LOG_MAX_ROWS=
# LOG_DETAILED=
# LOG_DETAILED_MAX_BYTES=
# LOG_MAX_DETAIL_BYTES=
# PARK_TIMEOUT_MS=
# MAX_LIVE_SESSIONS=
# CONVERSATION_TTL_DAYS=
# IGNORE_SAMPLING_PARAMS=
# SSE_KEEPALIVE_MS=
# AUTH_FAILURE_LIMIT=
# CORS_ALLOW_ORIGINS=*  # comma-separated exact origins; empty disables CORS
# GIT_COMMIT=   # shown on GET /health; image build should pass the git SHA
#
# On Linux, compose bind mounts need the host uid or the container cannot
# read a mode-0600 gateway.toml.
# GATEWAY_UID=
# GATEWAY_GID=
