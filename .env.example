# 日常部署走 data/config/gateway.toml。下面这些只用于临时覆盖，不是必填。
# CURSOR_API_KEY=
# ADMIN_ACCESS_KEY=
# API_KEY_PEPPER=
# GATEWAY_HOST=127.0.0.1
# GATEWAY_PORT=8787
# DATA_DIR=data
# CURSOR_WORKSPACE=
# LOG_RETENTION_DAYS=
# LOG_MAX_ROWS=
# LOG_DETAILED=
# LOG_DETAILED_MAX_BYTES=
# LOG_MAX_DETAIL_BYTES=
#
# Linux 上 compose bind mount 要用宿主机 uid，否则 0600 的 gateway.toml 容器读不了。
# GATEWAY_UID=
# GATEWAY_GID=
