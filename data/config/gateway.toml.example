# Copy to gateway.toml, fill values, then: chmod 600 gateway.toml
# Do not commit gateway.toml with real secrets.

# Listen address. Priority: GATEWAY_HOST env > this `host` > GATEWAY_DEFAULT_HOST env > 127.0.0.1.
# Unset: Docker image listens on 0.0.0.0 (it sets GATEWAY_DEFAULT_HOST); without Docker, 127.0.0.1 only.
# Set "0.0.0.0" for LAN access outside Docker (behind a firewall), or "127.0.0.1" to keep a container local-only.
# host = "127.0.0.1"
port = 8787

cursor_api_key = ""
# Optional extra keys, comma-separated; requests rotate across healthy keys
# and fail over on upstream auth / rate-limit errors.
# cursor_api_keys = ""
# cursor_key_cooldown_ms = 60000
# cursor_key_strategy = "round_robin"
# anthropic_count_tokens = "off"  # "estimate" enables approximate local token counts
# model_aliases = "claude-*=composer-2.5"
admin_access_key = ""
api_key_pepper = ""

# data_dir = "data"
# cursor_workspace = "data/workspace"
# park_timeout_ms = 300000
# max_live_sessions = 256
# conversation_ttl_days = 30
# ignore_sampling_params = false
# enforce_output_limits = false   # true: max_tokens / stop are enforced by the gateway (estimated tokens)
# allow_max_mode = true          # false: never run Cursor max-mode variants (non-max fallback or 403)
# quota_cache_read_weight = 1.0  # 0..1 weight of cache-read tokens in per-key token quotas
# sse_keepalive_ms = 15000
# auth_failure_limit = 20
# cors_allow_origins = "*" # exact HTTP(S) origins separated by commas; empty disables CORS
# trusted_proxies = "127.0.0.1"   # reverse proxies whose X-Forwarded-For is trusted; empty = none

[logs]
# Request log retention in SQLite (admin UI). Oldest rows are deleted first.
retention_days = 7
max_rows = 100000
# Record request/response JSON in SQLite (default off). Stores prompts in plaintext — keep data/ private.
detailed = false
# detailed_max_bytes = 65536
# Cap total UTF-8 bytes of model + detail columns. Oldest rows dropped first.
# max_detail_bytes = 268435456

# Docker (NODE_ENV=production): missing gateway.toml is auto-created empty on first start.
# Without host/port: 127.0.0.1:8787 (Docker image: 0.0.0.0:8787 via GATEWAY_DEFAULT_HOST).
